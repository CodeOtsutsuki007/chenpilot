{
  "name": "chenpilot-experimental",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:performance": "node --expose-gc ./node_modules/jest/bin/jest.js tests/performance --runInBand",
    "test:performance:record": "node --expose-gc ./node_modules/jest/bin/jest.js tests/performance --runInBand && ts-node --transpile-only scripts/recordPerformanceResults.ts",
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./src/config/Datasource.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./src/config/Datasource.ts",
    "schema:sync": "npm run typeorm schema:sync -- -d src/config/Datasource.ts",
    "migration:show": "npm run typeorm migration:show -- -d src/config/Datasource.ts",
    "migration:generate": "npm run typeorm migration:generate -- -d src/config/Datasource.ts -p src/migrations/",
    "cleanup:tokens": "ts-node src/scripts/cleanupTokens.ts",
    "test:webhooks": "jest --runInBand --testPattern=webhookIdempotency.integration",
    "smoke:clean-checkout": "node scripts/repo/verify-clean-install.mjs && jest --runInBand tests/integration/local_workflow_environment.integration.test.ts",
    "redteam": "jest tests/redteam --runInBand --json --outputFile=redteam-report.json",
    "redteam:check": "jest tests/redteam --runInBand",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "build:sdk": "npm --prefix packages/sdk run build",
    "test:sdk": "npm --prefix packages/sdk test -- --runInBand",
    "contracts:check": "cargo check --manifest-path contracts/Cargo.toml --workspace",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "contracts:fuzz": "cargo test --manifest-path contracts/Cargo.toml --workspace -- test_diff_fuzz",
    "release:artifact-check": "node scripts/repo/check-package-manifests.mjs --require-entry-files",
    "release:gates": "npm run build:check && npm test -- --runInBand && npm run redteam:check && npm run build:sdk && npm run test:sdk && npm --prefix packages/sdk run test:conformance && npm run contracts:check && npm run contracts:test && npm run release:artifact-check",
    "prepare": "husky",
    "gen:docs": "node scripts/generateTooDocs.mjs",
    "authz:graph": "ts-node --transpile-only scripts/generatePrivilegeGraph.ts",
    "authz:graph:check": "ts-node --transpile-only scripts/generatePrivilegeGraph.ts --check",
    "docs:index": "node scripts/docs/check-doc-index.mjs --write",
    "docs:check": "node scripts/docs/check-root-artifacts.mjs && node scripts/docs/check-markdown-links.mjs && node scripts/docs/check-doc-index.mjs && node scripts/docs/check-archive.mjs",
    "test:docs": "node --test tests/docs/*.test.mjs",
    "repo:check": "node scripts/repo/check-generated-files.mjs && node scripts/repo/check-dependency-aliases.mjs && node scripts/repo/check-install-workflow.mjs && node scripts/repo/check-package-manifests.mjs",
    "test:repo": "node --test tests/repo/*.test.mjs"
  },
  "lint-staged": {
    "*{.ts,.js,.mjs}": "eslint --fix",
    "src/Agents/tools/*.ts": "npm run gen:docs",
    "*{.ts,.js,mjs,json,md}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gear5labs/chenpilot.git"
  },
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@simplewebauthn/server": "^8.0.0",
    "@stellar/stellar-sdk": "^14.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cockatiel": "^3.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "nodemon": "^3.1.9",
    "pg": "^8.16.3",
    "rate-limit-redis": "^6.0.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "starknet": "^7.6.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.26",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "30.2.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^63.3.2",
    "fast-check": "^4.5.3",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
