{
  "rootArtifacts": {
    "patterns": ["_*.txt"],
    "artifactDir": ".artifacts"
  },
  "linkCheck": {
    "include": ["**/*.md"],
    "exclude": [
      {
        "glob": "docs/TOOLS.md",
        "reason": "Generated by `npm run gen:docs` from src/Agents/tools."
      },
      {
        "glob": ".kiro/**",
        "reason": "Editor-agent spec workspace, not maintained project documentation."
      },
      {
        "glob": ".trae/**",
        "reason": "Editor-agent workspace, not maintained project documentation."
      },
      {
        "glob": "**/node_modules/**",
        "reason": "Third-party package content."
      }
    ]
  },
  "index": {
    "file": "INDEX.md",
    "docsMap": {
      "begin": "<!-- BEGIN GENERATED: docs-map (npm run docs:index) -->",
      "end": "<!-- END GENERATED: docs-map -->",
      "include": ["docs/**/*.md"]
    }
  },
  "archive": {
    "dir": "docs/archive",
    "manifest": "docs/archive/README.md"
  }
}
